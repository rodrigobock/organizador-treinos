# ─── Local Development (docker-compose) ──────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=organizador_treinos
QUARKUS_PROFILE=dev

# ─── Backend ──────────────────────────────────────────────────────────────────

# Database
# Local:    DB_URL=jdbc:postgresql://localhost:5432/organizador_treinos
# Supabase: DB_URL=jdbc:postgresql://db.XXXX.supabase.co:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/organizador_treinos
DB_USERNAME=postgres
DB_PASSWORD=postgres

# CORS — comma-separated, no spaces
# Add your Vercel domain in production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Keys — paste full PEM content (Render supports multi-line env vars)
# Generate with: openssl genrsa -out privateKey.pem 2048
#                openssl rsa -in privateKey.pem -pubout -out publicKey.pem
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# HTTP Port — Render sets this automatically (usually 10000), leave unset locally
# PORT=8080

# ─── Frontend ─────────────────────────────────────────────────────────────────

# Vercel: set REACT_APP_API_URL to your Render backend URL
# e.g. https://organizador-treinos-backend.onrender.com
REACT_APP_API_URL=http://localhost:8080
